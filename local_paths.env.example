# Paths that are specific to your machine or cluster.
#
# Copy this file to local_paths.env (same folder) and fill in your own paths.
# local_paths.env is gitignored, so your paths are never committed.
#
# Format: one NAME=/absolute/path per line. No spaces around "=", no quotes,
# and no comments on the same line as a value. R and Python both read it.

# Where the scripts save and load their data objects (marker matrices, prepared data, models).
STORAGE_DIR=/path/to/storage

# Folder that holds the Human Breast Cell Atlas, hbca-global.h5ad.
HBCA_DIR=/path/to/hbca/data
